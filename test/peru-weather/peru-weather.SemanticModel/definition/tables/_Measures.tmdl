table _Measures
	lineageTag: 5ea4eefd-8d8f-4a3c-bace-838f8f7033f0

	measure '002. Temp. Min. Card.' = ```
			
			/*Values*/
			VAR _rowMinTemp = TOPN(1, ClimaPeru, ClimaPeru[temp_min], ASC)
			VAR _temp_min = MINX(_rowMinTemp, ClimaPeru[temp_min])
			VAR _fecha = FORMAT(MAXX(_rowMinTemp, ClimaPeru[Fecha]), "D-MMM-YYYY")
			VAR _hora = FORMAT(MAXX(_rowMinTemp, ClimaPeru[Hora]), "h:mm AM/PM")
			
			VAR _ciudad_prov = MAXX(_rowMinTemp, RELATED(Deptos[NOMBRE_PROV]))
			VAR _ciudad_dpto = MAXX(_rowMinTemp, RELATED(Deptos[NOMBRE_REGION]))
			VAR _ciudad = _ciudad_prov & " - " & _ciudad_dpto
			
			VAR _viento = MAXX(_rowMinTemp, ClimaPeru[Viento])
			VAR _humedad = MAXX(_rowMinTemp, ClimaPeru[Humedad])
			VAR _presion = MAXX(_rowMinTemp, ClimaPeru[Presion])
			VAR _descripcion = MAXX(_rowMinTemp, ClimaPeru[descripcion])
			
			
			/*Icons weather description*/
			VAR _url = 
			    SWITCH(
			        _descripcion,
			        "clear sky", "https://bmcdn.nl/assets/weather-icons/v3.0/fill/svg/clear-day.svg",
			        "few clouds", "https://bmcdn.nl/assets/weather-icons/v3.0/fill/svg/partly-cloudy-day.svg",
			        "scattered clouds", "https://bmcdn.nl/assets/weather-icons/v3.0/fill/svg/cloudy.svg",
			        "broken clouds", "https://bmcdn.nl/assets/weather-icons/v3.0/fill/svg/overcast-day.svg",
			        "overcast clouds", "https://bmcdn.nl/assets/weather-icons/v3.0/fill/svg/overcast.svg",
			        "light rain", "https://bmcdn.nl/assets/weather-icons/v3.0/fill/svg/partly-cloudy-day-rain.svg",
			        "moderate rain", "https://bmcdn.nl/assets/weather-icons/v3.0/fill/svg/rain.svg",
			        "heavy intensity rain", "https://bmcdn.nl/assets/weather-icons/v3.0/fill/svg/extreme-rain.svg",
			        "snow", "https://bmcdn.nl/assets/weather-icons/v3.0/fill/svg/snow.svg",
			        "light snow", "https://bmcdn.nl/assets/weather-icons/v3.0/fill/svg/partly-cloudy-day-snow.svg",
			        "heavy snow", "https://bmcdn.nl/assets/weather-icons/v3.0/fill/svg/extreme-snow.svg",
			        "fog", "https://bmcdn.nl/assets/weather-icons/v3.0/fill/svg/fog.svg",
			        "haze", "https://bmcdn.nl/assets/weather-icons/v3.0/fill/svg/haze.svg"
			    )
			
			/*Descripcion del clima - ES-PE*/
			VAR _descripcionES =
			    SWITCH(
			        TRUE(),
			        _descripcion = "clear sky", "Cielo despejado",
			        _descripcion = "few clouds", "Parcialmente nublado",
			        _descripcion = "scattered clouds", "Nubes dispersas",
			        _descripcion = "broken clouds", "Mayormente nublado",
			        _descripcion = "overcast clouds", "Nublado",
			        _descripcion = "light rain", "Lluvia ligera",
			        _descripcion = "moderate rain", "Lluvia moderada",
			        _descripcion = "heavy intensity rain", "Lluvia fuerte",
			        _descripcion = "snow", "Nieve",
			        _descripcion = "light snow", "Nieve ligera",
			        _descripcion = "heavy snow", "Nieve fuerte",
			        _descripcion = "fog", "Niebla",
			        _descripcion = "haze", "Neblina",
			        ""
			    )
			
			
			
			
			/*Color de gradiente de fondo */
			VAR _color_gradiente_bg_1 = "#C5DFF5"       //----------- #89cff0 para T Max
			VAR _color_gradiente_bg_2 = "#F7F9FA"       //----------- #6fb3f2 para T Max
			
			VAR _gradient = _color_gradiente_bg_1 & ", " & _color_gradiente_bg_2  //  No modificar
			
			
			/*Tipografía*/
			VAR _color_font = "#03204b"                    //----------- #fff para T Max  
			VAR _font_family = "'Poppins'"
			
			
			VAR _header = "Temperatura Mínima"
			
			/*Color Waves*/
			VAR _color_waves = "rgba(114,172,248,0.45)" //----------- rgba(255,255,255,0.30)  
			
			
			RETURN
			
			"
			<!DOCTYPE html>
			<html lang='es'>
			<head>
			  <link href='https://fonts.googleapis.com/css2?family=Poppins:wght@600&display=swap' rel='stylesheet'>
			  <link rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css'>
			
			  <style>
			    :root {
			      --gap-vertical: 12px;
			      --gap-horizontal: 45px;
			      --wave-height: 110px;
			      --wave-speed: 40s;
			      --wave-opacity: 0.32;
			      --wave-rotate: 0deg;
			    }
			
			    body {
			      font-family: "& _font_family &", sans-serif;
			      background: #ffffff00;
			      display: flex;
			      justify-content: center;
			      align-items: center;
			      height: 120vh;
			      margin: 0;
			    }
			
			    .card {
			      position: relative;
			      background: linear-gradient(to bottom right, "& _gradient &");
			      color: " & _color_font & ";
			      width: 100%;
			      border-radius: 18px;
			      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
			      padding: 15px;
			      overflow: hidden;
			    }
			
			    .wave {
			      position: absolute;
			      bottom: -6px;
			      left: 0;
			      width: 200%;
			      height: var(--wave-height);
			      transform: rotate(var(--wave-rotate));
			      transform-origin: left bottom;
			      z-index: 1;
			      pointer-events: none;
			      opacity: var(--wave-opacity);
			      overflow: hidden;
			    }
			
			    .wave__inner {
			      width: 200%;
			      height: 100%;
			      display: flex;
			      align-items: flex-end;
			      animation: waveShift var(--wave-speed) linear infinite;
			    }
			
			    .wave__inner svg {
			      width: 50%;
			      height: 100%;
			      display: block;
			    }
			
			    .wave__inner svg:first-child {
			      margin-right: -1px;
			    }
			
			    @keyframes waveShift {
			      from { transform: translateX(0); }
			      to   { transform: translateX(-50%); }
			    }
			
			    .card *:not(.wave):not(.wave *) {
			      position: relative;
			      z-index: 2;
			    }
			
			    .card-header {
			      display: flex;
			      align-items: center;
			      font-size: 1.7rem;
			      font-weight: 500;
			      margin-bottom: 15px;
			    }
			
			    .card-header i {
			      margin-right: 8px;
			      font-size: 1.5rem;
			      font-weight: 400;
			    }
			
			    .weather {
			      display: flex;
			      align-items: center;
			      justify-content: space-between;
			      margin-bottom: 10px;
			    }
			
			    .temp {
			      font-size: 3rem;
			      font-weight: 500;
			    }
			
			    .icon {
			      text-align: center;
			      margin-right: 4rem;
			    }
			
			    .icon img {
			      width: 18rem;
			      max-width: 120px
			    }
			
			    .icon div {
			      font-size: 1rem;
			      margin-top: 3px;
			    }
			
			    .details {
			        display: grid;
			        grid-template-columns: 1fr 1fr;
			        row-gap: var(--gap-vertical);
			        column-gap: var(--gap-horizontal);
			        font-size: 1.3rem;
			    }
			
			    .details div {
			        display: flex;
			        align-items: center;
			        gap: 10px;
			        min-width: 0;
			    }
			
			    .details i {
			        font-size: 1.3rem;
			        flex-shrink: 0;
			    }
			
			
			    .details div span {
			        overflow: hidden;
			        text-overflow: ellipsis; 
			        white-space: nowrap;
			        display: inline-block;
			    }
			
			  </style>
			</head>
			<body>
			
			  <div class='card'>
			    <div class='wave' aria-hidden='true'>
			      <div class='wave__inner'>
			        <svg viewBox='0 0 1200 120' preserveAspectRatio='none' xmlns='http://www.w3.org/2000/svg'>
			          <path d='
			            M0 60
			            C75 0 225 0 300 60
			            C375 120 525 120 600 60
			            C675 0 825 0 900 60
			            C975 120 1125 120 1200 60
			            L1200 120 L0 120 Z'
			            fill='" & _color_waves & "' />
			        </svg>
			        <svg viewBox='0 0 1200 120' preserveAspectRatio='none' xmlns='http://www.w3.org/2000/svg'>
			          <path d='
			            M0 60
			            C75 0 225 0 300 60
			            C375 120 525 120 600 60
			            C675 0 825 0 900 60
			            C975 120 1125 120 1200 60
			            L1200 120 L0 120 Z'
			            fill='" & _color_waves & "' />
			        </svg>
			      </div>
			    </div>
			
			    <div class='card-header'>
			        <img src='https://bmcdn.nl/assets/weather-icons/v3.0/fill/svg/thermometer-colder.svg' width='72' style='margin-right:8px;'>
			        "& _header &"
			    </div>
			
			    <div class='weather'>
			      <div class='temp'>" & _temp_min & " C°</div>
			      <div class='icon'>
			        <img id='weatherIcon' src='" & _url & "' alt='" & _descripcionES & "'>
			    <div>" & _descripcionES & "</div>
			      </div>
			    </div>
			
			    <div class='details'>
			        <div><i class='fa-solid fa-location-dot'></i><span>" & _ciudad & "</span></div>
			        <div><i class='fa-solid fa-wind'></i><span>" & _viento & " Km/h</span></div>
			
			        <div><i class='fa-regular fa-calendar'></i><span>" & _fecha & "</span></div>
			        <div><i class='fa-solid fa-droplet'></i><span>" & _humedad & " %</span></div>
			
			        <div><i class='fa-regular fa-clock'></i><span>" & _hora & "</span></div>
			        <div><i class='fa-solid fa-gauge-high'></i><span>" & _presion & " hPa</span></div>
			    </div>
			
			  </div>
			
			</body>
			</html>
			
			"
			```
		lineageTag: 9a7d99a4-ff81-4a20-9649-860f49376640

	measure '001. Avg Temp' = AVERAGE(ClimaPeru[temperatura])
		lineageTag: cafd525b-5cb4-4240-a315-1739319e4f28

		formatStringDefinition = "0.0# °C"

	measure '000. Provincia' = SELECTEDVALUE(Deptos[NOMBRE_PROV])
		lineageTag: 1a967c11-88a3-4699-bbe5-a4db18c4aa51

	measure '003. Temp. Max. Card.' = ```
			
			/*Values*/
			VAR _rowMaxTemp = TOPN(1, ClimaPeru, ClimaPeru[temp_max], DESC)
			VAR _temp_max = MINX(_rowMaxTemp, ClimaPeru[temp_min])
			VAR _fecha = FORMAT(MAXX(_rowMaxTemp, ClimaPeru[Fecha]), "D-MMM-YYYY")
			VAR _hora = FORMAT(MAXX(_rowMaxTemp, ClimaPeru[Hora]), "h:mm AM/PM")
			
			VAR _ciudad_prov = MAXX(_rowMaxTemp, RELATED(Deptos[NOMBRE_PROV]))
			VAR _ciudad_dpto = MAXX(_rowMaxTemp, RELATED(Deptos[NOMBRE_REGION]))
