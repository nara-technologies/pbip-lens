	/// [STRESS TEST] Grupo 7 - Medidas Condicionales / IF-SWITCH
	measure 'ST_061 Clasificacion Temperatura' =
			VAR _avg = AVERAGE(ClimaPeru[temperatura])
			RETURN
			SWITCH(
			    TRUE(),
			    _avg >= 30, "Muy Calido",
			    _avg >= 20, "Calido",
			    _avg >= 10, "Templado",
			    _avg >= 0,  "Frio",
			    "Muy Frio"
			)
		displayFolder: "STRESS TEST\07 Medidas Condicionales"
		lineageTag: a1000061-0000-0000-0000-000000000061

	measure 'ST_062 Alerta Humedad Critica' =
			IF(AVERAGE(ClimaPeru[humedad]) > 90, "⚠ CRITICA", "Normal")
		displayFolder: "STRESS TEST\07 Medidas Condicionales"
		lineageTag: a1000062-0000-0000-0000-000000000062

	measure 'ST_063 Semaforo Temperatura' =
			VAR _avg = AVERAGE(ClimaPeru[temperatura])
			RETURN
			SWITCH(
			    TRUE(),
			    _avg > 35, "🔴 EXTREMO",
			    _avg > 25, "🟡 ALTO",
			    _avg > 15, "🟢 NORMAL",
			    "🔵 BAJO"
			)
		displayFolder: "STRESS TEST\07 Medidas Condicionales"
		lineageTag: a1000063-0000-0000-0000-000000000063

	measure 'ST_064 Tiene Registros Nieve' =
			IF(
			    CALCULATE(COUNTROWS(ClimaPeru), ClimaPeru[descripcion] IN {"snow","light snow","heavy snow"}) > 0,
			    "Sí",
			    "No"
			)
		displayFolder: "STRESS TEST\07 Medidas Condicionales"
		lineageTag: a1000064-0000-0000-0000-000000000064

	measure 'ST_065 Temp Color Rule' =
			VAR _diff = AVERAGE(ClimaPeru[temperatura]) - CALCULATE(AVERAGE(ClimaPeru[temperatura]), ALL(Deptos))
			RETURN
			IF(_diff > 0, 1, IF(_diff < 0, -1, 0))
		displayFolder: "STRESS TEST\07 Medidas Condicionales"
		lineageTag: a1000065-0000-0000-0000-000000000065
		formatString: "0"

	measure 'ST_066 Presion Anormal Flag' =
			IF(
			    AVERAGE(ClimaPeru[presion]) < 990 || AVERAGE(ClimaPeru[presion]) > 1030,
			    "ANORMAL", "Normal"
			)
		displayFolder: "STRESS TEST\07 Medidas Condicionales"
		lineageTag: a1000066-0000-0000-0000-000000000066

	measure 'ST_067 Viento Descripcion' =
			VAR _v = AVERAGE(ClimaPeru[viento])
			RETURN
			SWITCH(
			    TRUE(),
			    _v < 5,  "Calma",
			    _v < 15, "Brisa Leve",
			    _v < 30, "Brisa Moderada",
			    _v < 50, "Viento Fresco",
			    "Viento Fuerte"
			)
		displayFolder: "STRESS TEST\07 Medidas Condicionales"
		lineageTag: a1000067-0000-0000-0000-000000000067

	measure 'ST_068 Indice Confort Termico' =
			VAR _t = AVERAGE(ClimaPeru[temperatura])
			VAR _h = AVERAGE(ClimaPeru[humedad])
			VAR _hi = _t + (0.33 * (_h / 100 * 6.105 * EXP(17.27 * _t / (237.7 + _t)))) - 4
			RETURN
			ROUND(_hi, 1)
		displayFolder: "STRESS TEST\07 Medidas Condicionales"
		lineageTag: a1000068-0000-0000-0000-000000000068
		formatString: "0.0"

	measure 'ST_069 Hay Seleccion Region' =
			IF(ISFILTERED(Deptos[NOMBRE_REGION]), "Filtrado", "Sin Filtro")
		displayFolder: "STRESS TEST\07 Medidas Condicionales"
		lineageTag: a1000069-0000-0000-0000-000000000069

	measure 'ST_070 Hay Seleccion Prov' =
			IF(HASONEVALUE(Deptos[NOMBRE_PROV]), SELECTEDVALUE(Deptos[NOMBRE_PROV]), "Múltiples")
		displayFolder: "STRESS TEST\07 Medidas Condicionales"
		lineageTag: a1000070-0000-0000-0000-000000000070

	/// [STRESS TEST] Grupo 8 - Operaciones de Texto / Formato
	measure 'ST_071 Descripcion Capitalizada' =
			UPPER(SELECTEDVALUE(ClimaPeru[descripcion], "Sin selección"))
		displayFolder: "STRESS TEST\08 Texto y Formato"
		lineageTag: a1000071-0000-0000-0000-000000000071

	measure 'ST_072 Resumen Clima Texto' =
			"Temp: " & FORMAT(AVERAGE(ClimaPeru[temperatura]), "0.0") & "°C | Hum: " & FORMAT(AVERAGE(ClimaPeru[humedad]), "0") & "% | Viento: " & FORMAT(AVERAGE(ClimaPeru[viento]), "0.0") & " km/h"
		displayFolder: "STRESS TEST\08 Texto y Formato"
		lineageTag: a1000072-0000-0000-0000-000000000072

	measure 'ST_073 Fecha Ultimo Registro Texto' =
			"Último dato: " & FORMAT(MAX(ClimaPeru[Fecha]), "DD MMM YYYY")
		displayFolder: "STRESS TEST\08 Texto y Formato"
		lineageTag: a1000073-0000-0000-0000-000000000073

	measure 'ST_074 Cantidad Descripciones Unicas' =
			DISTINCTCOUNT(ClimaPeru[descripcion])
		displayFolder: "STRESS TEST\08 Texto y Formato"
		lineageTag: a1000074-0000-0000-0000-000000000074
		formatString: "0"

	measure 'ST_075 Descripcion Mas Frecuente' =
			VAR _t = SUMMARIZE(ClimaPeru, ClimaPeru[descripcion], "N", COUNTROWS(ClimaPeru))
			RETURN
			MAXX(TOPN(1, _t, [N], DESC), ClimaPeru[descripcion])
		displayFolder: "STRESS TEST\08 Texto y Formato"
		lineageTag: a1000075-0000-0000-0000-000000000075

	measure 'ST_076 Temp Formateada Con Unidad' =
			FORMAT(AVERAGE(ClimaPeru[temperatura]), "0.00") & " °C"
		displayFolder: "STRESS TEST\08 Texto y Formato"
		lineageTag: a1000076-0000-0000-0000-000000000076

	measure 'ST_077 Region Seleccionada' =
			SELECTEDVALUE(Deptos[NOMBRE_REGION], "Todas las regiones")
		displayFolder: "STRESS TEST\08 Texto y Formato"
		lineageTag: a1000077-0000-0000-0000-000000000077

	measure 'ST_078 Total Registros Texto' =
			FORMAT(COUNTROWS(ClimaPeru), "#,0") & " registros"
		displayFolder: "STRESS TEST\08 Texto y Formato"
		lineageTag: a1000078-0000-0000-0000-000000000078

	measure 'ST_079 Concatenar Region Prov' =
			SELECTEDVALUE(Deptos[NOMBRE_REGION], "N/A") & " > " & SELECTEDVALUE(Deptos[NOMBRE_PROV], "N/A")
		displayFolder: "STRESS TEST\08 Texto y Formato"
		lineageTag: a1000079-0000-0000-0000-000000000079

	measure 'ST_080 Descripcion Traducida ES' =
			VAR _d = SELECTEDVALUE(ClimaPeru[descripcion], "")
			RETURN
			SWITCH(
			    _d,
			    "clear sky", "Cielo despejado",
			    "few clouds", "Pocas nubes",
			    "scattered clouds", "Nubes dispersas",
			    "broken clouds", "Nublado parcial",
			    "overcast clouds", "Nublado",
			    "light rain", "Lluvia ligera",
			    "moderate rain", "Lluvia moderada",
			    "heavy intensity rain", "Lluvia intensa",
			    "fog", "Niebla",
			    "haze", "Neblina",
			    "snow", "Nieve",
			    _d
			)
		displayFolder: "STRESS TEST\08 Texto y Formato"
		lineageTag: a1000080-0000-0000-0000-000000000080

	/// [STRESS TEST] Grupo 9 - Cálculos Iterativos / SUMX / MAXX
	measure 'ST_081 SUMX Temp x Humedad' =
			SUMX(ClimaPeru, ClimaPeru[temperatura] * ClimaPeru[humedad])
		displayFolder: "STRESS TEST\09 Cálculos Iterativos"
		lineageTag: a1000081-0000-0000-0000-000000000081
		formatString: "#,0.00"

	measure 'ST_082 MAXX Presion Absoluta' =
			MAXX(ClimaPeru, ClimaPeru[presion])
		displayFolder: "STRESS TEST\09 Cálculos Iterativos"
		lineageTag: a1000082-0000-0000-0000-000000000082
		formatString: "0"

	measure 'ST_083 MINX Sensacion Termica' =
			MINX(ClimaPeru, ClimaPeru[sensacion])
		displayFolder: "STRESS TEST\09 Cálculos Iterativos"
		lineageTag: a1000083-0000-0000-0000-000000000083
		formatString: "0.00"

	measure 'ST_084 SUMX Diferencia Temp Max Min' =
			SUMX(ClimaPeru, ClimaPeru[temp_max] - ClimaPeru[temp_min])
		displayFolder: "STRESS TEST\09 Cálculos Iterativos"
		lineageTag: a1000084-0000-0000-0000-000000000084
		formatString: "#,0.00"

	measure 'ST_085 AVERAGEX Indice Viento Presion' =
			AVERAGEX(
			    ClimaPeru,
			    DIVIDE(ClimaPeru[viento], ClimaPeru[presion]) * 1000
			)
		displayFolder: "STRESS TEST\09 Cálculos Iterativos"
		lineageTag: a1000085-0000-0000-0000-000000000085
		formatString: "0.0000"

	measure 'ST_086 SUMX Por Region' =
			SUMX(
			    VALUES(Deptos[NOMBRE_REGION]),
			    CALCULATE(AVERAGE(ClimaPeru[temperatura]))
			)
		displayFolder: "STRESS TEST\09 Cálculos Iterativos"
		lineageTag: a1000086-0000-0000-0000-000000000086
		formatString: "0.00"

	measure 'ST_087 MAXX Prom Temp Por Prov' =
			MAXX(
			    VALUES(Deptos[NOMBRE_PROV]),
			    CALCULATE(AVERAGE(ClimaPeru[temperatura]))
			)
		displayFolder: "STRESS TEST\09 Cálculos Iterativos"
		lineageTag: a1000087-0000-0000-0000-000000000087
		formatString: "0.00"

	measure 'ST_088 MINX Prom Temp Por Region' =
			MINX(
			    VALUES(Deptos[NOMBRE_REGION]),
			    CALCULATE(AVERAGE(ClimaPeru[temperatura]))
			)
		displayFolder: "STRESS TEST\09 Cálculos Iterativos"
		lineageTag: a1000088-0000-0000-0000-000000000088
		formatString: "0.00"

	measure 'ST_089 COUNTX Registros Calidos' =
			COUNTX(
			    FILTER(ClimaPeru, ClimaPeru[temperatura] > 25),
			    ClimaPeru[id]
			)
		displayFolder: "STRESS TEST\09 Cálculos Iterativos"
		lineageTag: a1000089-0000-0000-0000-000000000089
		formatString: "#,0"

	measure 'ST_090 SUMX Viento Ponderado x Horas' =
			SUMX(
			    ClimaPeru,
			    ClimaPeru[viento] * (1 + ClimaPeru[Hour] / 24)
			)
		displayFolder: "STRESS TEST\09 Cálculos Iterativos"
		lineageTag: a1000090-0000-0000-0000-000000000090
		formatString: "#,0.00"

	/// [STRESS TEST] Grupo 10 - Medidas de Auditoría (Validación de Datos)
	measure 'ST_091 Registros Temperatura Nula' =
			COUNTROWS(FILTER(ClimaPeru, ISBLANK(ClimaPeru[temperatura])))
		displayFolder: "STRESS TEST\10 Auditoría y Validación"
		lineageTag: a1000091-0000-0000-0000-000000000091
		formatString: "#,0"

	measure 'ST_092 Registros Duplicados Por Fecha Prov' =
			SUMX(
			    SUMMARIZE(ClimaPeru, ClimaPeru[Fecha], ClimaPeru[id_prov], ClimaPeru[Hour], "N", COUNTROWS(ClimaPeru)),
			    IF([N] > 1, [N] - 1, 0)
			)
		displayFolder: "STRESS TEST\10 Auditoría y Validación"
		lineageTag: a1000092-0000-0000-0000-000000000092
		formatString: "#,0"

	measure 'ST_093 Provincias Sin Datos Clima' =
			CALCULATE(
			    COUNTROWS(Deptos),
			    EXCEPT(VALUES(Deptos[ID_PROV]), VALUES(ClimaPeru[id_prov]))
			)
		displayFolder: "STRESS TEST\10 Auditoría y Validación"
		lineageTag: a1000093-0000-0000-0000-000000000093
		formatString: "#,0"

	measure 'ST_094 Integridad Referencial' =
			VAR _total_clima = CALCULATE(DISTINCTCOUNT(ClimaPeru[id_prov]), ALL(ClimaPeru))
			VAR _total_deptos = CALCULATE(COUNTROWS(Deptos), ALL(Deptos))
			RETURN
			DIVIDE(_total_clima, _total_deptos)
		displayFolder: "STRESS TEST\10 Auditoría y Validación"
		lineageTag: a1000094-0000-0000-0000-000000000094
		formatString: "0.00%"

	measure 'ST_095 Registros Temp Fuera Rango' =
			CALCULATE(
			    COUNTROWS(ClimaPeru),
			    ClimaPeru[temperatura] < -20 || ClimaPeru[temperatura] > 50
			)
		displayFolder: "STRESS TEST\10 Auditoría y Validación"
		lineageTag: a1000095-0000-0000-0000-000000000095
		formatString: "#,0"

	measure 'ST_096 Registros Humedad Invalida' =
			CALCULATE(
			    COUNTROWS(ClimaPeru),
			    ClimaPeru[humedad] < 0 || ClimaPeru[humedad] > 100
			)
		displayFolder: "STRESS TEST\10 Auditoría y Validación"
		lineageTag: a1000096-0000-0000-0000-000000000096
		formatString: "#,0"

	measure 'ST_097 Registros Viento Negativo' =
			CALCULATE(
			    COUNTROWS(ClimaPeru),
			    ClimaPeru[viento] < 0
			)
		displayFolder: "STRESS TEST\10 Auditoría y Validación"
		lineageTag: a1000097-0000-0000-0000-000000000097
		formatString: "#,0"

	measure 'ST_098 Completitud Datos Pct' =
			DIVIDE(
			    CALCULATE(COUNTROWS(ClimaPeru), NOT ISBLANK(ClimaPeru[temperatura])),
			    COUNTROWS(ClimaPeru)
			)
		displayFolder: "STRESS TEST\10 Auditoría y Validación"
		lineageTag: a1000098-0000-0000-0000-000000000098
		formatString: "0.00%"

	measure 'ST_099 Score Calidad General' =
			VAR _completitud = DIVIDE(CALCULATE(COUNTROWS(ClimaPeru), NOT ISBLANK(ClimaPeru[temperatura])), COUNTROWS(ClimaPeru))
			VAR _sin_invalidos = DIVIDE(CALCULATE(COUNTROWS(ClimaPeru), ClimaPeru[humedad] >= 0 && ClimaPeru[humedad] <= 100), COUNTROWS(ClimaPeru))
			VAR _sin_negativos = DIVIDE(CALCULATE(COUNTROWS(ClimaPeru), ClimaPeru[viento] >= 0), COUNTROWS(ClimaPeru))
			RETURN
			ROUND((_completitud + _sin_invalidos + _sin_negativos) / 3 * 100, 2)
		displayFolder: "STRESS TEST\10 Auditoría y Validación"
		lineageTag: a1000099-0000-0000-0000-000000000099
		formatString: "0.00"

	measure 'ST_100 Resumen Ejecutivo Auditoria' =
			VAR _reg = COUNTROWS(ClimaPeru)
			VAR _prov = DISTINCTCOUNT(ClimaPeru[id_prov])
			VAR _dias = DISTINCTCOUNT(ClimaPeru[Fecha])
			VAR _avg_t = FORMAT(AVERAGE(ClimaPeru[temperatura]), "0.0")
			VAR _max_t = FORMAT(MAX(ClimaPeru[temp_max]), "0.0")
			VAR _min_t = FORMAT(MIN(ClimaPeru[temp_min]), "0.0")
			RETURN
			"📊 Registros: " & FORMAT(_reg, "#,0") &
			" | 🗺 Provincias: " & _prov &
			" | 📅 Días: " & _dias &
			" | 🌡 T.Prom: " & _avg_t & "°C" &
			" | ↑ " & _max_t & "°C" &
			" | ↓ " & _min_t & "°C"
		displayFolder: "STRESS TEST\10 Auditoría y Validación"
		lineageTag: a1000100-0000-0000-0000-000000000100

	partition _Measures = m
		mode: import
		source =
				let
				    Origen = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Columna1 = _t]),
				    #"Tipo cambiado" = Table.TransformColumnTypes(Origen,{{"Columna1", type text}}),
				    #"Columnas quitadas" = Table.RemoveColumns(#"Tipo cambiado",{"Columna1"})
				in
				    #"Columnas quitadas"

	annotation PBI_ResultType = Table

