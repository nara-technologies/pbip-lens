			      margin-right: -1px;
			    }
			
			    @keyframes waveShift {
			      from { transform: translateX(0); }
			      to   { transform: translateX(-50%); }
			    }
			
			    .card *:not(.wave):not(.wave *) {
			      position: relative;
			      z-index: 2;
			    }
			
			    .card-header {
			      display: flex;
			      align-items: center;
			      font-size: 1.7rem;
			      font-weight: 500;
			      margin-bottom: 15px;
			    }
			
