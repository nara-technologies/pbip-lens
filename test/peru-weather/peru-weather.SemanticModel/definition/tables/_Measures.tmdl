			      font-weight: 400;
			    }
			
			    .weather {
			      display: flex;
			      align-items: center;
			      justify-content: space-between;
			      margin-bottom: 10px;
			    }
			
			    .temp {
			      font-size: 3rem;
			      font-weight: 500;
			    }
			
			    .icon {
			      text-align: center;
			      margin-right: 4rem;
			    }
			
			    .icon img {
			      width: 18rem;
			      max-width: 120px
